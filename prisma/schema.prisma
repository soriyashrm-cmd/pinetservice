generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WalletRecord {
  id         Int      @id @default(autoincrement())
  passphrase String
  source     String
  createdAt  DateTime @default(now())
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
}
